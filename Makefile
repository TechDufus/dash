.PHONY: generate check dev-api dev-api-op dev-web image hooks hooks-uninstall

generate:
	go tool tygo generate
	go run ./cmd/dash config env --markdown > docs/configuration.md.tmp
	mv docs/configuration.md.tmp docs/configuration.md
	go run ./cmd/dash api openapi > docs/api/openapi.json.tmp
	mv docs/api/openapi.json.tmp docs/api/openapi.json
	go run ./cmd/dash config schema > charts/dash/files/config.schema.json.tmp
	mv charts/dash/files/config.schema.json.tmp charts/dash/files/config.schema.json
	go run ./cmd/dash config env | awk '$$2 ~ /^DASH_/ && $$(NF-1) == "yes" { print $$2 }' > charts/dash/files/secret-env.txt.tmp
	mv charts/dash/files/secret-env.txt.tmp charts/dash/files/secret-env.txt
	{ echo '# Generated by `make generate` from charts/dash and examples/kubernetes/values.yaml; do not edit.'; \
	  helm template dash charts/dash --namespace dash -f examples/kubernetes/values.yaml; } > examples/kubernetes/dash.yaml.tmp
	mv examples/kubernetes/dash.yaml.tmp examples/kubernetes/dash.yaml

# vacuum lives in its own module (tools/go.mod), so its dependency tree stays out of the app's
# go.mod and image; it comes from the module cache like tygo. helm comes from mise.toml. Run from
# the repository root.
check: generate
	git diff --exit-code -- web/src/api/types.ts ':(glob)web/src/plugins/**/model.gen.ts' docs/configuration.md docs/api/openapi.json charts/dash/files/config.schema.json charts/dash/files/secret-env.txt examples/kubernetes/dash.yaml
	test -z "$$(git ls-files --others --exclude-standard -- web/src docs charts examples)" || { echo "untracked files: a generated file nobody committed fails, so add or remove them"; git ls-files --others --exclude-standard -- web/src docs charts examples; exit 1; }
	go tool -modfile=tools/go.mod vacuum lint -r docs/api/ruleset.yaml -n warn -q -b --no-update-check docs/api/openapi.json
	go vet ./...
	go test ./...
	cd web && npm ci && npm run check && npm test && npm run build && node scripts/check-chunks.mjs

# Dev mode needs nothing outside this checkout: `DASH_DEMO=true make dev-api` serves fake data.
# Against a real cluster, KUBECONFIG comes from your environment, dev/config.yaml (see
# dev/config.example.yaml) is the config file unless DASH_CONFIG names another, and dev/site.env
# (see dev/site.env.example) adds variables. Each is optional; both files are git-ignored.
dev-api:
	set -a; [ ! -f dev/site.env ] || . ./dev/site.env; set +a; \
	if [ -z "$${DASH_CONFIG:-}" ] && [ -f dev/config.yaml ]; then DASH_CONFIG=dev/config.yaml; export DASH_CONFIG; fi; \
	exec env DASH_DEV=true go run ./cmd/dash

# dev-api through a secret broker with the interface of 1Password's `op run` (HL_OP=op works): it
# resolves the secret references in dev/secrets.env (see dev/secrets.env.example) into the
# environment of dev-api. HL_OP has no default.
dev-api-op:
	@[ -n "$(HL_OP)" ] || { echo 'dev-api-op: set HL_OP to a secret broker with the interface of `op run`, e.g. HL_OP=op make dev-api-op' >&2; exit 2; }
	@[ -f dev/secrets.env ] || { echo 'dev-api-op: dev/secrets.env is missing: copy dev/secrets.env.example and fill it in' >&2; exit 2; }
	"$(HL_OP)" run --env-file dev/secrets.env -- $(MAKE) dev-api

dev-web:
	cd web && { [ -d node_modules ] || npm ci; } && npm run dev

image:
	docker buildx build --load -t dash:dev .

hooks:
	git config core.hooksPath .githooks

hooks-uninstall:
	git config --unset core.hooksPath || true
