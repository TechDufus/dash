.PHONY: generate check dev-api dev-api-op dev-web image hooks hooks-uninstall

generate: web/node_modules/.package-lock.json
	go tool tygo generate
	go run ./cmd/dash config env --markdown > docs/configuration.md.tmp
	mv docs/configuration.md.tmp docs/configuration.md
	go run ./cmd/dash api openapi > docs/api/openapi.json.tmp
	mv docs/api/openapi.json.tmp docs/api/openapi.json
	go run ./cmd/dash config schema > charts/dash/files/config.schema.json.tmp
	mv charts/dash/files/config.schema.json.tmp charts/dash/files/config.schema.json
	go run ./cmd/dash config env | awk '$$2 ~ /^DASH_/ && $$(NF-1) == "yes" { print $$2 }' > charts/dash/files/secret-env.txt.tmp
	mv charts/dash/files/secret-env.txt.tmp charts/dash/files/secret-env.txt
	{ echo '# Generated by `make generate` from charts/dash and examples/kubernetes/values.yaml; do not edit.'; \
	  helm template dash charts/dash --namespace dash -f examples/kubernetes/values.yaml; } > examples/kubernetes/dash.yaml.tmp
	mv examples/kubernetes/dash.yaml.tmp examples/kubernetes/dash.yaml
	HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 NO_PROXY= no_proxy= \
	  $(GO_LICENSES) report ./cmd/dash --ignore github.com/TechDufus/dash \
	  --template tools/notices/go.tpl $(GO_LICENSES_LOG) > THIRD_PARTY_NOTICES.go.tmp
	{ cat tools/notices/header.md; cd web && node scripts/licenses.mjs notices ../THIRD_PARTY_NOTICES.go.tmp; } > THIRD_PARTY_NOTICES.md.tmp
	rm THIRD_PARTY_NOTICES.go.tmp
	mv THIRD_PARTY_NOTICES.md.tmp THIRD_PARTY_NOTICES.md

# go-licenses (tools/go.mod), built for this machine and run on the linux build of dash, the one
# the image ships. Only its errors are printed: its warnings are about assembly files it cannot
# follow and about licence URLs. `report` looks up each module's licence URL over HTTPS; the
# notices print no URL, so a proxy that refuses every connection keeps the run offline and its
# output the same.
GO_LICENSES = GOOS=linux GOARCH=amd64 CGO_ENABLED=0 "$$(go tool -modfile=tools/go.mod -n go-licenses)"
GO_LICENSES_LOG = --logtostderr=false --log_file=/dev/null --stderrthreshold=ERROR

# The notices read web/node_modules: install it when it is missing or older than the lockfile.
# Install scripts are not needed.
web/node_modules/.package-lock.json: web/package-lock.json
	cd web && npm ci --ignore-scripts

# vacuum and go-licenses live in their own module (tools/go.mod), so their dependency trees stay
# out of the app's go.mod and image; they come from the module cache like tygo. helm comes from
# mise.toml. Run from the repository root. The licence policy: no Go package under a forbidden,
# restricted or unknown licence (go-licenses' classes), and npm runtime licences only from the
# allowlist in web/scripts/licenses.mjs.
check: generate
	git diff --exit-code -- web/src/api/types.ts ':(glob)web/src/plugins/**/model.gen.ts' docs/configuration.md docs/api/openapi.json charts/dash/files/config.schema.json charts/dash/files/secret-env.txt examples/kubernetes/dash.yaml THIRD_PARTY_NOTICES.md
	test -z "$$(git ls-files --others --exclude-standard -- web/src docs charts examples THIRD_PARTY_NOTICES.md)" || { echo "untracked files: a generated file nobody committed fails, so add or remove them"; git ls-files --others --exclude-standard -- web/src docs charts examples THIRD_PARTY_NOTICES.md; exit 1; }
	go tool -modfile=tools/go.mod vacuum lint -r docs/api/ruleset.yaml -n warn -q -b --no-update-check docs/api/openapi.json
	$(GO_LICENSES) check ./cmd/dash --disallowed_types=forbidden,restricted,unknown $(GO_LICENSES_LOG)
	go vet ./...
	go test ./...
	cd web && npm ci && node scripts/licenses.mjs check && npm run check && npm test && npm run build && node scripts/check-chunks.mjs

# Dev mode needs nothing outside this checkout: `DASH_DEMO=true make dev-api` serves fake data.
# Against a real cluster, KUBECONFIG comes from your environment, dev/config.yaml (see
# dev/config.example.yaml) is the config file unless DASH_CONFIG names another, and dev/site.env
# (see dev/site.env.example) adds variables. Each is optional; both files are git-ignored.
dev-api:
	set -a; [ ! -f dev/site.env ] || . ./dev/site.env; set +a; \
	if [ -z "$${DASH_CONFIG:-}" ] && [ -f dev/config.yaml ]; then DASH_CONFIG=dev/config.yaml; export DASH_CONFIG; fi; \
	exec env DASH_DEV=true go run ./cmd/dash

# dev-api through a secret broker with the interface of 1Password's `op run` (HL_OP=op works): it
# resolves the secret references in dev/secrets.env (see dev/secrets.env.example) into the
# environment of dev-api. HL_OP has no default.
dev-api-op:
	@[ -n "$(HL_OP)" ] || { echo 'dev-api-op: set HL_OP to a secret broker with the interface of `op run`, e.g. HL_OP=op make dev-api-op' >&2; exit 2; }
	@[ -f dev/secrets.env ] || { echo 'dev-api-op: dev/secrets.env is missing: copy dev/secrets.env.example and fill it in' >&2; exit 2; }
	"$(HL_OP)" run --env-file dev/secrets.env -- $(MAKE) dev-api

dev-web: web/node_modules/.package-lock.json
	cd web && npm run dev

image:
	docker buildx build --load -t dash:dev .

hooks:
	git config core.hooksPath .githooks

hooks-uninstall:
	git config --unset core.hooksPath || true
