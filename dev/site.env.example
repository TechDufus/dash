# Copy to dev/site.env (git-ignored) and fill in your lab; `make dev-api` loads it.
# In dev the monitoring services are reached through the cluster's API server proxy: use their
# in-cluster addresses. A source left out is "not configured".
DASH_PLUGINS_PROMETHEUS_URL=http://prometheus.monitoring.svc:9090
DASH_PLUGINS_ALERTMANAGER_URL=http://alertmanager.monitoring.svc:9093
DASH_PLUGINS_VICTORIALOGS_URL=http://victorialogs.monitoring.svc:9428
DASH_PLUGINS_GATUS_URL=http://gatus.gatus.svc:8080
DASH_PLUGINS_PROXMOX_URL=https://pve.example.com:8006
DASH_PLUGINS_PROXMOX_NODE=pve
DASH_PLUGINS_HARDWARE_HOSTS='[{"model":"Dell R730"}]'
DASH_PLUGINS_HEADLAMP_URL=https://headlamp.example.com
DASH_PLUGINS_GRAFANA_URL=https://grafana.example.com
# A launcher file like docs/launcher.example.yaml; dev/launcher.yaml is git-ignored too.
DASH_PLUGINS_LAUNCHER_FILE=dev/launcher.yaml
# Launcher icon names (proxmox, idrac, ...) need an icon base; without it the links show letter
# tiles. App icons on the Apps page are not affected by this setting.
DASH_UI_ICON_BASE_URL=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png
