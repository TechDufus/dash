# Copy to dev/secrets.env (git-ignored) for `make dev-api-op`. HL_OP (a secret broker with the
# interface of 1Password's `op run`) reads this file, replaces every value that is a secret reference
# with the secret, and runs `make dev-api` with the result in its environment. Plain values pass
# through unchanged. Reference syntax:
# https://developer.1password.com/docs/cli/secret-reference-syntax/
#
# The Proxmox API token, as user@realm!tokenname and its secret.
DASH_PLUGINS_PROXMOX_TOKEN_ID=dash@pve!dash
DASH_PLUGINS_PROXMOX_TOKEN_SECRET=<secret reference to the token secret>
