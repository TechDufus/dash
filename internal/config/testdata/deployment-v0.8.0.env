# The whole environment of the homelab deployment at v0.8.0 (G3 PR-2, contract 10.2), with
# placeholder hosts and secrets: the v0.7.0 environment plus the four variables the PR changes
# (CRITICAL_VMS_IDS, STORAGE_SOURCE, HARDWARE_HOSTS replaced, HARDWARE_MACHINES). One NAME=value per
# line, the value verbatim (JSON lists unquoted). TestDeploymentEnvV08 (internal/config) and
# TestDeploymentEnvReachesThePlugins (cmd/dash) read this one file, so the two cannot drift.
DASH_SERVER_PUBLIC_URL=https://dash.example.com
DASH_SERVER_READY_REQUIRES=["kubernetes"]
DASH_SETTINGS_UI=readonly
DASH_PLUGINS_PROMETHEUS_URL=http://vm.example.com:8428
DASH_PLUGINS_ALERTMANAGER_URL=http://alertmanager.example.com:9093
DASH_PLUGINS_VICTORIALOGS_URL=http://vlogs.example.com:9428
DASH_PLUGINS_GATUS_URL=http://gatus.example.com:8080
DASH_PLUGINS_PROXMOX_URL=https://pve.example.com:8006
DASH_PLUGINS_HEADLAMP_URL=https://headlamp.example.com
DASH_PLUGINS_GRAFANA_URL=https://grafana.example.com
DASH_PLUGINS_PROXMOX_NODE=node-1
DASH_PLUGINS_PROXMOX_TOKEN_ID=dash@pve!ci
DASH_PLUGINS_PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
DASH_PLUGINS_LAUNCHER_FILE=/etc/dash/launcher.yaml
DASH_PLUGINS_KUBERNETES_CONVENTIONS_PROTECTED_LABEL=example.com/protected
DASH_PLUGINS_KUBERNETES_CONVENTIONS_TENANT_LABEL=example.com/tenant
DASH_PLUGINS_KUBERNETES_CONVENTIONS_APPS_FLUX_PREFIX=apps-
DASH_PLUGINS_FLUX_SUSPEND_REASON_ANNOTATION=example.com/suspended
DASH_PLUGINS_HARDWARE_ZFS_SCRUB_METRIC_PREFIX=site_zfs_scrub
DASH_PLUGINS_KUBERNETES_BACKUP_JOBS=[{"namespace":"backup","cronjob":"nightly"}]
DASH_PLUGINS_ALERTMANAGER_ACTIONS_ENABLED=true
DASH_PLUGINS_GATUS_CRITICAL_GROUPS=["infrastructure"]
DASH_UI_ICON_BASE_URL=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png
DASH_PLUGINS_PROXMOX_CRITICAL_VMS_IDS=[101,102,103]
DASH_PLUGINS_PROXMOX_STORAGE_SOURCE=prometheus
DASH_PLUGINS_HARDWARE_HOSTS=[{"model":"Example 2U server","bays":16,"fanMaxRPM":18000}]
DASH_PLUGINS_HARDWARE_MACHINES=[{"name":"mini-1","nodeExporterNodename":"mini-1"},{"name":"pi-1","gatusEndpoint":"pi-1 SSH"}]
